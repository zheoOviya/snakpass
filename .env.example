# ============================================================
# SnakZap Environment Variables
# ============================================================
# Copy this file to .env (local dev) or set these in Vercel
# Project Settings → Environment Variables (for production).
#
# Lines marked [REQUIRED] must be set before the app will work.
# Lines marked [OPTIONAL] have sensible defaults.
# Lines marked [PRODUCTION ONLY] are only for Vercel/production.
# Lines marked [TEST ONLY] are for evidence/security testing.
# ============================================================


# ------------------------------------------------------------
# 1. DATABASE (REQUIRED)
# ------------------------------------------------------------
# Local dev: SQLite file
# Production (Vercel): Supabase PostgreSQL Transaction Pooler connection
#
# LOCAL DEV:
DATABASE_URL=file:/home/z/my-project/db/custom.db
#
# PRODUCTION (Vercel) — use Supabase pooler connection (port 6543):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-ap-northeast-1.pooler.supabase.com:6543/postgres


# ------------------------------------------------------------
# 2. SUPABASE (REQUIRED for auth)
# ------------------------------------------------------------
# Get these from: Supabase Dashboard → Project Settings → API
#
# NEXT_PUBLIC_SUPABASE_URL=https://[your-project-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=[your-anon-key]
#
# Server-side admin access (service role — keep secret!):
# SUPABASE_URL=https://[your-project-ref].supabase.co
# SUPABASE_SECRET_KEY=[your-service-role-key]
# SUPABASE_JWKS_URL=https://[your-project-ref].supabase.co/.well-known/jwks.json


# ------------------------------------------------------------
# 3. RAZORPAY PAYMENT (REQUIRED for real payments)
# ------------------------------------------------------------
# Get these from: Razorpay Dashboard → Settings → API Keys → Test Mode
#
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
#
# Webhook secret — get from: Razorpay Dashboard → Settings → Webhooks
# (When you create a webhook, Razorpay generates this secret)
#
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------
# 4. FEATURE FLAGS (REQUIRED — controls which features are ON)
# ------------------------------------------------------------
# Format: FEATURE_[NAME]=true/false
#
# --- Razorpay Test Mode (enable real Razorpay test API calls) ---
FEATURE_REAL_PAYMENTS=false
#
# --- Webhook Handler (enable POST /api/webhooks/razorpay) ---
FEATURE_WEBHOOK_HANDLER=false
#
# --- Pickup Attribution Enforcement (QR+OTP pickup verification) ---
FEATURE_PICKUP_ATTRIBUTION_ENFORCEMENT=false
#
# --- Outbox Publisher (enable outbox event processing) ---
FEATURE_OUTBOX_PUBLISHER=false
#
# --- Concurrency Control (optimistic locking) ---
FEATURE_CONCURRENCY_CONTROL=false
#
# --- Request Hash Enforcement (idempotency key body hash check) ---
FEATURE_REQUEST_HASH_ENFORCEMENT=false
#
# --- Reconciliation Auto-Repair (M16 operational only) ---
FEATURE_RECONCILIATION_AUTO_REPAIR=false
#
# --- State Invariant Checker (M18-M21 detectors) ---
FEATURE_INVARIANT_CHECKER=false
#
# --- DR Drill Mode (simulates disaster recovery) ---
FEATURE_DR_DRILL_MODE=false
#
# For Razorpay Test Mode validation, set these to true:
# FEATURE_REAL_PAYMENTS=true
# FEATURE_WEBHOOK_HANDLER=true


# ------------------------------------------------------------
# 5. REALTIME (OPTIONAL — mini-service URL)
# ------------------------------------------------------------
# Used by the outbox publisher to emit realtime events
# On Vercel: set to your realtime mini-service URL (or leave empty)
REALTIME_URL=http://localhost:3003


# ------------------------------------------------------------
# 6. REALTIME SERVICE TOKEN (OPTIONAL — publisher ↔ realtime auth)
# ------------------------------------------------------------
# Shared secret between outbox publisher and realtime service
# Generate a random string: openssl rand -hex 32
# REALTIME_SERVICE_TOKEN=


# ------------------------------------------------------------
# 7. LOGGING (OPTIONAL)
# ------------------------------------------------------------
# Set to 'debug' for verbose logging, 'info' for normal
LOG_LEVEL=info


# ------------------------------------------------------------
# 8. NEXT.JS (AUTO — do not change)
# ------------------------------------------------------------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1


# ============================================================
# The following are ONLY for evidence/security testing.
# DO NOT set these in production!
# ============================================================

# ------------------------------------------------------------
# 9. EVIDENCE TEST MODE (TEST ONLY — DO NOT USE IN PRODUCTION)
# ------------------------------------------------------------
# Enables test-only API routes + failure injection
# EVIDENCE_TEST_MODE=true

# ------------------------------------------------------------
# 10. EVIDENCE GATEWAY STATUS (TEST ONLY)
# ------------------------------------------------------------
# Simulates Razorpay gateway responses in demo mode
# EVIDENCE_GATEWAY_STATUS=captured
# EVIDENCE_GATEWAY_REFUND_STATUS=processed


# ============================================================
# VERCEL DEPLOYMENT QUICK REFERENCE
# ============================================================
# For Vercel production deployment, set these in
# Vercel → Project Settings → Environment Variables:
#
# 1. DATABASE_URL          = postgresql://...@aws-...supabase.com:6543/postgres
# 2. NEXT_PUBLIC_SUPABASE_URL = https://[ref].supabase.co
# 3. NEXT_PUBLIC_SUPABASE_ANON_KEY = [key]
# 4. SUPABASE_URL          = https://[ref].supabase.co
# 5. SUPABASE_SECRET_KEY   = [service-role-key]
# 6. SUPABASE_JWKS_URL     = https://[ref].supabase.co/.well-known/jwks.json
# 7. RAZORPAY_KEY_ID       = rzp_test_xxxxxxxxxxxxx
# 8. RAZORPAY_KEY_SECRET   = xxxxxxxxxxxxxxxxxxxxxxxx
# 9. RAZORPAY_WEBHOOK_SECRET = whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# 10. FEATURE_REAL_PAYMENTS = true
# 11. FEATURE_WEBHOOK_HANDLER = true
# 12. NEXT_TELEMETRY_DISABLED = 1
#
# All set for "Production" environment.
# ============================================================
