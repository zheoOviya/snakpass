// SnakZap — Prisma schema (PostgreSQL)
// Pickup-first food ordering platform: catalog, ordering, fulfillment, governance.

generator client {
  provider      = "prisma-client-js"
  // Vercel serverless runs on Amazon Linux 2 (rhel-openssl-3.0.x).
  // Build runs on debian (debian-openssl-3.0.x). Include both so the
  // query engine binary is available at runtime. Without rhel-openssl-3.0.x,
  // Prisma throws: "could not locate the Query Engine for runtime rhel-openssl-3.0.x".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------
// Identity context
// ----------------------------------------
model User {
  id              String   @id @default(cuid())
  phone           String   @unique
  email           String?  @unique
  passwordHash    String?
  name            String?
  role            String   @default("CONSUMER") // CONSUMER | VENDOR_OWNER | ADMIN | SUPER_ADMIN
  spiceTolerance  Int      @default(3) // 0..5
  walletBalance   Int      @default(0) // paise
  createdAt       DateTime @default(now())
  orders          Order[]
  auditLogs       AuditLog[]
  sessions        Session[]

  // --------------------------------------------------------------------
  // PRODUCT FOUNDATION (PLAN-01) — additive nullable columns (backward-compat)
  // Governance: blueprint §29, §50. These columns do NOT modify any existing
  // field, constraint, or index. They are nullable with no default-required
  // backfill — existing rows remain valid. New code (Wave 2+) reads these
  // columns; absent code is unaffected (Prisma select/include defaults unchanged).
  // --------------------------------------------------------------------
  // Primary campus linkage — set during first-run onboarding (Wave 2 Task 2A).
  // Nullable so existing demo users (created pre-onboarding) remain valid.
  campusId         String?
  campus           Campus?  @relation(fields: [campusId], references: [id])
}

// ----------------------------------------
// Auth context (OTP + sessions)
// ----------------------------------------
model OtpRequest {
  id        String   @id @default(cuid())
  channel   String   // 'phone' | 'email'
  target    String   // phone number or email
  purpose   String   // 'consumer_login' | 'vendor_login' | 'admin_2fa' | 'pickup'
  codeHash  String   // scrypt hash of the 6-digit code
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  // P0-11: Track failed verify attempts per OTP record.
  // Max 5 failed attempts before the OTP is locked (must request a new one).
  attemptCount Int @default(0)

  @@index([target, purpose])
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  // P0-10: Track last-known IP for session-anomaly detection (geo/IP change).
  lastIp    String?
  // P0-10: Last activity timestamp for sliding refresh + idle timeout.
  lastActivityAt DateTime @default(now())
  @@index([userId])
}

// ----------------------------------------
// P0-11 — OTP lockout store (per-target send/attempt counters)
// ----------------------------------------
// Tracks per-target (phone/email) OTP attempt + send counts within a rolling
// 10-minute window. When limits are exceeded, the target is locked out until
// the window expires.
model OtpLockout {
  id              String   @id @default(cuid())
  target          String   @unique // phone number or email
  // Rolling window counters (reset when lockoutExpiresAt passes)
  sendCount       Int      @default(0)     // OTP sends in current window (max 3)
  verifyFailCount Int      @default(0)     // failed verify attempts in current window (max 5)
  // Lockout: when set, OTP send/verify is rejected until this time passes
  lockedUntil     DateTime?
  updatedAt       DateTime @updatedAt
}

// ----------------------------------------
// Catalog context
// ----------------------------------------
model Restaurant {
  id             String     @id @default(cuid())
  name           String
  cuisine        String     // e.g. "North Indian", "South Indian", "Chinese"
  description    String
  image          String
  rating         Float      @default(4.5)
  prepTimeMins   Int        @default(20)
  priceForTwo    Int        @default(300) // paise
  commissionRate Float      @default(0.08)
  isActive       Boolean    @default(true)
  isSuspended    Boolean    @default(false)
  gstNumber      String     @default("29ABCDE1234F1Z5")
  address        String     @default("")
  createdAt      DateTime   @default(now())
  menuItems      MenuItem[]
  orders         Order[]

  // --------------------------------------------------------------------
  // PRODUCT FOUNDATION (PLAN-01) — additive nullable columns + back-relations.
  // Governance: blueprint §29, §50. No existing field/constraint/index modified.
  // --------------------------------------------------------------------
  // Primary campus — nullable so existing restaurants without a campus remain
  // valid. The full many-to-many is via RestaurantCampus junction below; this
  // column is the denormalized "primary" for fast UI display.
  campusId           String?
  campus             Campus?  @relation(fields: [campusId], references: [id])
  // ownerUserId is a SOFT FK to User.id (no Prisma relation declared — avoids
  // touching the User model). Used by vendor RBAC on the new
  // POST /api/vendor/orders/[id]/accept endpoint (per plan Risk R10) to verify
  // the calling vendor owns the restaurant before recording `acceptedAt`.
  ownerUserId        String?
  // Back-relations for new additive models (no columns added — Prisma relation
  // fields are metadata only; FKs live on the child side).
  restaurantCampuses RestaurantCampus[]
  groupOrders        GroupOrder[]

  // --------------------------------------------------------------------
  // WAVE 4B (Vendor Menu Management) — additive back-relation for VendorDeal.
  // No column added — Prisma relation field is metadata only; FK lives on the
  // child side (VendorDeal.restaurantId). Preserved unchanged: all existing
  // fields, relations, constraints, and indexes above.
  // --------------------------------------------------------------------
  deals VendorDeal[]
}

model MenuItem {
  id             String       @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String
  description    String
  price          Int          // paise
  image          String
  spiceLevel     Int          @default(1) // 0..3 (mild/medium/hot/extra)
  isVeg          Boolean      @default(true)
  isAvailable    Boolean      @default(true)
  // P0-25 Case A: Inventory race protection.
  // availableCount tracks remaining quantity (NULL = unlimited availability,
  // modeled via isAvailable only). When set, concurrent orders must decrement
  // it atomically inside a transaction.
  availableCount Int?
  // P0-25: Optimistic-locking version field. Incremented on every update.
  // Conditional UPDATE (`WHERE version = X`) prevents last-writer-wins races.
  version        Int          @default(0)
  category       String       @default("Mains") // Starters | Mains | Breads | Rice | Desserts | Beverages
  createdAt      DateTime     @default(now())
  orderItems     OrderItem[]

  // --------------------------------------------------------------------
  // PRODUCT FOUNDATION (PLAN-01) — additive back-relations for new models.
  // No columns added — these are Prisma relation fields (metadata only).
  // Required so Gift.menuItem and GroupOrderItem.menuItem relations compile.
  // --------------------------------------------------------------------
  gifts            Gift[]
  groupOrderItems  GroupOrderItem[]

  // --------------------------------------------------------------------
  // WAVE 4B (Vendor Menu Management) — additive nullable columns.
  // Governance: blueprint §23 (configure reward multiplier). These columns do
  // NOT modify any existing field, constraint, or index. Both are nullable
  // (rewardMultiplier has a @default(1.0) so existing rows backfill cleanly;
  // deletedAt is null for all existing rows). New code (vendor-menu-manager +
  // /api/vendor/menu/*) reads/writes these; absent legacy code is unaffected.
  // --------------------------------------------------------------------
  // Reward-points multiplier applied to orders containing this item
  // (1.0 = base earn rate; 2.0 = double points; max 3.0 per blueprint §17).
  rewardMultiplier Float       @default(1.0)
  // Soft-delete timestamp — set by DELETE /api/vendor/menu/[id]. When non-null,
  // the item is excluded from public catalog reads (filter: deletedAt IS NULL)
  // but preserved for historical OrderItem references. NULL = not deleted.
  deletedAt        DateTime?
}

// ----------------------------------------------------------------------------
// WAVE 4B (Vendor Menu Management) — VendorDeal model.
// Governance: blueprint §23 (create deal). Additive — no existing model
// modified. Restaurant.deals back-relation added above (metadata only).
// ----------------------------------------------------------------------------
// Tracks vendor-created promotional deals (percentage off, fixed-amount off,
// or free-item grant). Active deals surface on the consumer menu card
// (DealBadge) and the vendor analytics dashboard (Task 4C).
//
// dealValue semantics (per `dealType`):
//   - "percentage" → 0..100 (percent off, e.g., 20 = 20% off)
//   - "fixed"      → paise amount off (e.g., 5000 = ₹50 off)
//   - "free_item"  → menu item id (cast to Int via hash) — currently stores 0;
//                    the actual menu-item ref lives in `menuItemId` (optional).
// ----------------------------------------------------------------------------
model VendorDeal {
  id            String    @id @default(cuid())
  restaurantId  String
  title         String
  description   String?
  dealType      String    // "percentage" | "fixed" | "free_item"
  dealValue     Int       // interpretation depends on dealType (see above)
  validFrom     DateTime
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  // Optional scope to a specific menu item (e.g., "free samosa with thali").
  // Nullable so a deal can apply restaurant-wide.
  menuItemId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, isActive])
}

// ----------------------------------------
// Ordering context
// ----------------------------------------
model Order {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  restaurantId   String
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id])
  status         String         @default("CONFIRMED") // CONFIRMED | PREPARING | ALMOST_READY | READY_FOR_PICKUP | PICKED_UP | CANCELLED | PAID | PAYMENT_PENDING
  totalAmount    Int            // paise
  pickupOtp      String         @default("000000")
  isCatering     Boolean        @default(false)
  headcount      Int?
  itemsCount     Int            @default(0)
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orderItems     OrderItem[]
  statusHistory  String         @default("[]") // JSON array of {status, at}
  // P0-25 Case B: State-transition race protection.
  version        Int            @default(0)
  // P0-01 Wave-3: 1:1 relation to Payment
  payment        Payment?
  // P0-06 Wave-6: 1:1 relation to Fulfilment (parallel state machine — additive, additive-only)
  // Order.status (NEXT_STATUS) is NOT modified — Fulfilment.status has its own
  // NEXT_FULFILMENT_STATUS machine (PREPARING → ALMOST_READY → READY_FOR_PICKUP → PICKED_UP).
  // Lazy-created on first access via GET/PATCH /api/orders/[id]/fulfilment.
  fulfilment     Fulfilment?
  // S5H1: Back-relation for SocialActivity.sourceOrderId (social proof).
  socialActivities SocialActivity[]
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  name          String
  price         Int      // paise (snapshot)
  quantity      Int      @default(1)
  subtotal      Int      // paise
  createdAt     DateTime @default(now())
}

// ----------------------------------------
// Governance context
// ----------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  actorRole String   @default("SYSTEM")
  action    String
  metadata  String   @default("{}") // JSON
  createdAt DateTime @default(now())
  // DEV-001: Hash-chain tamper-evidence. Each entry's hash = SHA-256(prevHash + entry data).
  // If any entry is modified or deleted, the chain breaks and integrity check detects it.
  // This makes tampering DETECTABLE; true PREVENTION requires storage-level WORM (production).
  prevHash  String   @default("GENESIS") // hash of previous entry; "GENESIS" for first
  hash      String   @default("") // SHA-256(prevHash + id + actorId + actorRole + action + metadata + createdAt)

  // S4C Repair-07: Explicit predecessor-linked append chain.
  // Eliminates inferred ordering — each entry explicitly names its predecessor.
  // Historical rows have these as NULL (pre-cutover). Post-cutover rows are non-null.
  prevAuditId  String?  // exact predecessor AuditLog.id (null for GENESIS or legacy)
  chainOrdinal BigInt?  // monotonic append ordinal (null for legacy)
  hashVersion  Int      @default(1) // 1=legacy hash, 2=explicit-chain hash
}

// S4C Repair-07: Singleton audit chain head state.
// This is the serialization authority for audit appends — the "chain head"
// is the last appended entry. Writers read this, create a new entry pointing
// to the current head, then advance the head in the SAME transaction.
// This eliminates race conditions and inferred ordering.
model AuditChainState {
  id           String   @id  // singleton: "GLOBAL"
  headAuditId  String?  // current chain head AuditLog.id (null = GENESIS)
  headHash     String   @default("GENESIS")  // current chain head hash
  nextOrdinal  BigInt   @default(1)  // next chainOrdinal for new entry
  version      Int      @default(0)  // optimistic-lock version for safe updates
  updatedAt    DateTime @updatedAt
}

model KillSwitch {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String
  enabled     Boolean  @default(false)
  severity    String   @default("HIGH") // LOW | MEDIUM | HIGH | CRITICAL
  updatedAt   DateTime @updatedAt
  // P0-25: Optimistic-locking version field for kill-switch toggles.
  // Prevents concurrent admin toggles from silently overwriting each other.
  version     Int      @default(0)
}

// ----------------------------------------
// P0-17 — Idempotency key store
// ----------------------------------------
// Stores the idempotency key + cached response for critical writes (orders,
// payments, refunds, status updates). Retries with the same key return the
// cached response instead of creating a duplicate resource.
//
// Usage: client sends `Idempotency-Key` header on POST /api/orders (and
// future payment routes). The server checks this table inside the same
// transaction as the business write — if the key exists, return the cached
// response; else execute the write + store the key + response.
model IdempotencyKey {
  id              String   @id @default(cuid())
  key             String   @unique // the client-provided idempotency key
  resourceType    String   // e.g. "Order", "Payment" — which resource this key created
  resourceId      String   // the id of the created resource (for lookup)
  // Cached response payload (status + body) so retries return the exact same response.
  responseStatus  Int      // HTTP status code
  responseBody    String   // JSON-serialized response body
  // Sub-Wave 3c: Request body hash (SHA-256 hex) for materially-different-request detection.
  // Nullable for backward compatibility — pre-3c records have null (hash check skipped).
  // When requestHashEnforcement flag is ON and this is non-null, a mismatch with the
  // incoming request hash throws IdempotencyKeyReuseError (HTTP 422).
  requestHash     String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime // TTL (default 24h); old keys are safe to delete

  @@index([resourceType, resourceId])
}

// ----------------------------------------
// P0-28 — Unknown-exception handling (exception queue + freeze state)
// ----------------------------------------
// When an invariant violation is detected (e.g., order in unknown state,
// payment amount mismatch, audit hash-chain break), the system:
//   1. Preserves evidence (full state snapshot + trace + invariant name)
//   2. Creates an ExceptionQueue entry
//   3. Applies the smallest sufficient freeze (Level 1/2/3)
//   4. Alerts
//
// Freeze levels:
//   Level 1 (TRANSACTION): freeze a single order/payment (set frozen=true)
//   Level 2 (ENTITY): quarantine a whole Restaurant/User (set quarantined=true)
//   Level 3 (SYSTEM): activate system kill switch (links to P0-23 KillSwitch)
model ExceptionQueue {
  id              String   @id @default(cuid())
  // What was violated (e.g., "I-02 Order Integrity", "UNKNOWN_STATE")
  invariant       String
  // The resource that triggered the exception
  entityType      String   // "Order" | "Payment" | "User" | "Restaurant" | "System"
  entityId        String   // the id of the affected resource
  // Freeze level applied: 1 (transaction) | 2 (entity) | 3 (system)
  freezeLevel     Int      @default(1)
  // Full state snapshot at time of detection (JSON: the resource state + context)
  stateSnapshot   String   // JSON
  // Trace ID for correlation with logs
  traceId         String?
  // Human-readable description of what went wrong
  description     String
  // Resolution tracking
  resolvedAt      DateTime?
  resolvedBy      String?  // admin user id who resolved it
  resolutionNote  String?  // what was done to resolve
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([freezeLevel, resolvedAt])
}

// ----------------------------------------
// P0-24 — Transactional outbox (cross-entity atomic writes)
// ----------------------------------------
// The Outbox table is the persistent event queue committed INSIDE the same
// transaction as the business write. This ensures the event is NOT lost even
// if the process crashes after commit — the outbox publisher worker will
// pick it up and deliver it later (at-least-once delivery).
//
// Key principle (Architectural Law 2 — Idempotent Business Effect):
//   "We do NOT chase technical 'exactly-once delivery.' We chase idempotent
//    business effect." — the consumer side deduplicates via the eventId.
//
// Usage:
//   await withTransaction(async (tx) => {
//     const order = await tx.order.create({ ... })      // business mutation
//     await enqueueOutboxEvent(tx, {                    // outbox INSERT (same txn)
//       eventType: 'ORDER_CREATED',
//       aggregateType: 'Order',
//       aggregateId: order.id,
//       payload: { orderId: order.id, status: order.status, ... },
//     })
//   })
//   // Publisher (Sub-Wave 2b) later reads PENDING rows + delivers via Socket.io
model Outbox {
  id              String   @id @default(cuid())
  // Unique event ID for consumer-side idempotency (Q17 decision: event id = idempotency key)
  eventId         String   @unique
  // Event type for routing (e.g., "ORDER_CREATED", "ORDER_STATUS_CHANGED", "KILL_SWITCH_TOGGLED")
  eventType       String
  // The aggregate root type (e.g., "Order", "KillSwitch")
  aggregateType   String
  // The aggregate root ID (e.g., order.id, kill-switch key)
  aggregateId     String
  // JSON payload of the event (the data the consumer needs)
  payload         String   // JSON
  // PENDING = not yet published; PUBLISHED = delivered by publisher; FAILED = max retries exhausted
  status          String   @default("PENDING") // PENDING | CLAIMED | PUBLISHED | FAILED
  // Number of publish attempts (for retry tracking + backoff)
  attempts        Int      @default(0)
  // Last error message (if publishing failed)
  lastError       String?
  // When the event was created (inside the business transaction)
  createdAt       DateTime @default(now())
  // When the publisher successfully delivered the event
  publishedAt     DateTime?
  // P0-24 2b-2: Claim/lease fields for crash-safe publisher
  // When a worker claims this event (sets status=CLAIMED)
  claimedAt       DateTime?
  // When the lease expires (if publisher crashes, another worker can re-claim after this time)
  claimUntil      DateTime?
  // ID of the worker that claimed this event (for debugging + lease management)
  workerId        String?

  @@index([status, createdAt]) // publisher polls WHERE status='PENDING' ORDER BY createdAt
  @@index([aggregateType, aggregateId]) // lookup by aggregate
}

// ----------------------------------------
// P0-24 Sub-Wave 2b — Consumer-side idempotency (ProcessedEvent)
// ----------------------------------------
// When the outbox publisher delivers an event, the consumer checks this
// table to determine if the event has already been processed. If the
// eventId exists, the business effect is NOT re-applied (exactly-once
// business effect, even if delivery happens multiple times).
//
// The dedup record and the protected business effect must be in the same
// transaction (atomic dedup).
model ProcessedEvent {
  // Matches Outbox.eventId — the consumer-side idempotency key
  eventId     String   @id
  // Event type (for debugging + audit)
  eventType   String
  // Which consumer processed it (for multi-consumer future)
  consumerId  String   @default("default")
  // When the event was processed
  processedAt DateTime @default(now())
  // Optional: payload hash for verification
  payloadHash String?

  @@index([consumerId, processedAt])
}

// ----------------------------------------
// P0-01 Wave-3 — Payment (Razorpay capture lifecycle)
// ----------------------------------------
model Payment {
  id               String    @id @default(cuid())
  orderId          String    @unique
  order            Order     @relation(fields: [orderId], references: [id])
  userId           String
  // Razorpay gateway linkage
  gatewayOrderId   String?   // razorpay_order_id (from order-create API)
  gatewayPaymentId String?   // razorpay_payment_id (after Checkout SDK)
  gatewaySignature String?   // X-Razorpay-Signature (HMAC-SHA256)
  // Amount (paise — consistent with Order.totalAmount)
  amount           Int
  currency         String    @default("INR")
  // Status lifecycle:
  //   PAYMENT_PENDING → CAPTURE_PENDING → CAPTURED
  //   CAPTURE_PENDING → FAILED
  //   CAPTURED → REFUND_PENDING → REFUNDED | FAILED (Wave-5 Sub-Wave 5a — P0-04)
  //   (any state) → FROZEN (P0-28 invariant freeze)
  status           String    @default("PAYMENT_PENDING")
  // I-04 Capture Uniqueness: capturedAt set once, never reset
  capturedAt       DateTime?
  // P0-25 Case C: Idempotency-Key linkage (payment double-click dedup)
  idempotencyKey   String?   @unique
  // P0-28: Freeze flag (per invariant-checker.ts:139)
  frozen           Boolean   @default(false)
  // P0-25: Optimistic-locking version field
  version          Int       @default(0)
  // Failure tracking
  failureReason    String?
  retryCount       Int       @default(0)
  // Ledger entries (double-entry: Dr + Cr per payment)
  ledgerEntries    LedgerEntry[]
  // P0-04 Wave-5 Sub-Wave 5a: Refunds (1:N — a payment may have multiple
  // partial refunds over its lifetime). Each Refund carries its own status
  // lifecycle (REFUND_PENDING → REFUNDED | FAILED) + double-entry reversal
  // LedgerEntry pair tied to its own paymentId FK (entries are append-only).
  refunds          Refund[]
  // Audit
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ----------------------------------------
// P0-02/P0-24 Wave-3 — LedgerEntry (double-entry, append-only)
// ----------------------------------------
model LedgerEntry {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id])
  // Double-entry: each Payment produces >=2 entries (Dr + Cr)
  entryType       String   // "DEBIT" | "CREDIT"
  accountType     String   // "GATEWAY_RECEIVABLE" | "CONSUMER_REVENUE" | "VENDOR_PAYOUT" | "COMMISSION_REVENUE" | "GATEWAY_FEE_EXPENSE"
  amount          Int      // paise; Dr and Cr sum to same total per Payment (I-06)
  // Traceability
  traceId         String?
  // Append-only: no updatedAt field (entries never updated)
  createdAt       DateTime @default(now())

  @@index([paymentId, entryType])
  @@index([accountType, createdAt])
}

// ----------------------------------------
// P0-05 Wave-3 — WebhookEvent (Razorpay webhook dedup + HMAC verification)
// ----------------------------------------
// Handler implementation in Wave-4 Sub-Wave 4a (P0-05)
model WebhookEvent {
  id              String   @id @default(cuid())
  eventId         String   @unique // Razorpay webhook event_id (dedup key, I-04)
  eventType       String   // "payment.captured" | "payment.failed" | "refund.processed"
  paymentId       String?  // FK to Payment (if webhook relates to a payment)
  // Raw webhook payload
  payload         String   // JSON
  payloadHash     String   // SHA-256 of payload
  signature       String   // X-Razorpay-Signature header
  verified        Boolean  @default(false) // HMAC verification result
  processed       Boolean  @default(false) // idempotent processing flag
  processedAt     DateTime?
  // Sub-Wave 4a: Processing metadata (nullable — set when processed)
  processedBy     String?  // worker/processor ID (for debugging)
  processingNotes String?  // failure reason or processing notes
  receivedAt     DateTime @default(now())

  @@index([eventType, receivedAt])
  @@index([processed, receivedAt])
}

// ----------------------------------------
// P0-04 Wave-5 Sub-Wave 5a — Refund (Razorpay refund lifecycle)
// ----------------------------------------
// A Refund is created when a CAPTURED payment is to be (partially or fully)
// refunded. The refund API call to Razorpay is performed by the outbox publisher
// (OUTSIDE any DB transaction) — the same Wave-4 4c pattern that protects the
// capture flow's TRANSACTION_RETRY_INVARIANT. The refund route only writes the
// Refund + reversal LedgerEntry pair + AuditLog + Outbox event inside a single
// transaction; the publisher then calls refundRazorpayPayment() and on success
// transitions Refund.status REFUND_PENDING → REFUNDED + Payment.status
// CAPTURED → REFUNDED (full refund) atomically.
//
// Lifecycle:
//   REFUND_PENDING (created by refund route, inside txn)
//     → REFUNDED   (publisher confirms Razorpay refund success, inside new txn)
//     → FAILED     (publisher exhausts retries / gateway declined)
//
// Partial refunds: amount < Payment.amount is allowed. Multiple Refunds per
// Payment are supported (1:N). Each Refund produces its own Dr/Cr reversal
// LedgerEntry pair tied to the same paymentId (entries are append-only — no
// updates to existing rows).
model Refund {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id])
  // Amount (paise). For a full refund, equals Payment.amount. For a partial
  // refund, is less than Payment.amount. Must be > 0.
  amount          Int
  currency        String   @default("INR")
  // REFUND_PENDING → REFUNDED | FAILED
  status          String   @default("REFUND_PENDING")
  // Razorpay refund ID (rpf_*) — set by the publisher after a successful refund.
  gatewayRefundId String?
  // P0-17: Idempotency-Key linkage (refund double-click dedup). Unique per
  // refund attempt — same key on retry returns the cached Refund.
  idempotencyKey  String?  @unique
  // Failure tracking (set by publisher on retry/decline).
  failureReason   String?
  // Set by publisher when Razorpay confirms the refund.
  refundedAt      DateTime?
  // P0-25: Optimistic-locking version field (race-safe conditional update).
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([paymentId, status])
  @@index([status, createdAt])
}

// ----------------------------------------
// P0-03 Wave-5 Sub-Wave 5b — Reconciliation (detection-only)
// ----------------------------------------
// Two Class-2 ADDITIVE models that store the audit trail of reconciliation
// runs + their findings. The reconciliation job is READ-ONLY with respect to
// all money-state tables (Payment, Refund, LedgerEntry, Outbox, WebhookEvent,
// IdempotencyKey, AuditLog). Its only writes are to these two tables + to
// ExceptionQueue (via the existing reportInvariantViolation() P0-28 path).
//
// ReconciliationRun: one row per reconciliation cycle (cron / manual / evidence).
// Tracks when it started, completed, what it checked, and what it found.
//
// ReconciliationFinding: one row per detected mismatch (deduped by
// (mismatchClass, entityId) while unresolved — a second run for the same
// mismatch updates lastSeenAt, NOT a new row). High-severity findings are
// routed to ExceptionQueue via reportInvariantViolation() (exceptionId FK).
//
// SAFETY CONTRACT (Orchestrator hard boundary):
//   - Reconciliation NEVER writes to Payment, Refund, LedgerEntry, Outbox,
//     WebhookEvent, IdempotencyKey, or AuditLog.
//   - Reconciliation NEVER makes external Razorpay API calls.
//   - Reconciliation NEVER triggers capture / refund / outbox enqueue.
//   - Reconciliation NEVER performs automatic financial correction.
//   - Its job is: detect → classify → record → report. Repair is a separate
//     authorization boundary (5C or dedicated Orchestrator directive).
model ReconciliationRun {
  id              String   @id @default(cuid())
  // What triggered this run: 'cron' | 'manual' | 'evidence'
  // (renamed from `trigger` — that's a reserved keyword in SQLite/Prisma)
  triggerType     String   @default("cron")
  // Status of the run itself: RUNNING | COMPLETED | FAILED
  status          String   @default("RUNNING")
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  // Summary counts (populated on completion)
  paymentsChecked Int      @default(0)
  refundsChecked  Int      @default(0)
  outboxChecked    Int      @default(0)
  webhooksChecked  Int      @default(0)
  findingsCount    Int      @default(0)
  // The mismatch_count metric value emitted for this run (activates the
  // existing 'reconciliation-mismatch' alert rule in alerting.ts).
  mismatchCount    Int      @default(0)
  // Error tracking (if the run itself failed)
  lastError        String?
  findings         ReconciliationFinding[]

  @@index([status, startedAt])
}

model ReconciliationFinding {
  id              String   @id @default(cuid())
  runId           String
  run             ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Mismatch class (M1-M17 from WAVE5_5B_GATE_REVIEW.md §2 D4)
  // e.g. "M1_LEDGER_IMBALANCE", "M9_STUCK_CAPTURE_PENDING", "M10_STUCK_REFUND_PENDING"
  mismatchClass   String
  // Severity: CRITICAL | HIGH | MEDIUM
  // CRITICAL/HIGH → routed to ExceptionQueue via reportInvariantViolation()
  severity        String
  // The affected entity type: "Payment" | "Refund" | "Outbox" | "WebhookEvent"
  entityType      String
  // The affected entity id (paymentId / refundId / outbox id / webhookEvent id)
  entityId        String
  // Full state snapshot at detection time (JSON — the evidence for the finding)
  stateSnapshot   String
  // Human-readable description of the mismatch
  description     String
  // Recommended remediation (informational only — NOT auto-applied)
  recommendedRemediation String?
  // ExceptionQueue entry id (set only for CRITICAL/HIGH findings routed via
  // reportInvariantViolation()). NULL for MEDIUM findings (logged + recorded
  // but not frozen).
  exceptionId     String?
  // Detection timestamps (idempotency: a second run for the same mismatch
  // updates lastSeenAt, NOT a new row)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  // Resolution tracking (admin action — manual, NOT automatic)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNote  String?
  // 5C: Remediation actions taken for this finding (1:N — a finding may be
  // repaired multiple times if the first repair fails + is retried).
  remediationActions RemediationAction[]

  // Idempotency: one unresolved finding per (mismatchClass, entityId).
  // A partial unique index on (mismatchClass, entityId) WHERE resolvedAt IS NULL
  // is created in the migration SQL. Prisma's @unique creates a full unique
  // index (including resolvedAt) which allows multiple resolved findings for
  // the same (mismatchClass, entityId) over time (audit trail) while preventing
  // duplicate unresolved findings.
  @@unique([mismatchClass, entityId, resolvedAt])
  @@index([severity, resolvedAt])
  @@index([entityType, entityId])
  @@index([runId])
}

// ----------------------------------------
// P0-03 Wave-5 Sub-Wave 5C — Remediation Action (M16-only, Class-2 additive)
// ----------------------------------------
// Audit trail for remediation/repair actions. Currently ONLY M16 (outbox lag —
// operational, non-financial) remediation is authorized. M3/M9/M10 + CLASS B/D/E
// are NOT authorized — they require separate Orchestrator directives.
//
// SI-6 (Safety Invariant): every repair writes a RemediationAction audit record.
// SI-2 (Repair Idempotency): the unique constraint on (findingId, repairType)
// prevents duplicate repair actions for the same finding + repair type. A second
// attempt to repair the same finding with the same repairType is a no-op (caught
// by the unique constraint → the handler skips).
//
// SAFETY CONTRACT (Orchestrator hard boundary for 5C-M16):
//   - M16 remediation NEVER writes to Payment, Refund, LedgerEntry, Outbox,
//     WebhookEvent, IdempotencyKey, or AuditLog.
//   - M16 remediation NEVER makes external Razorpay API calls.
//   - M16 remediation's only "external" action is an HTTP call to the outbox
//     publisher's /trigger endpoint (operational restart — no financial mutation).
//   - M16 remediation's only DB writes are to this table (RemediationAction) +
//     ReconciliationFinding (resolves the finding).
model RemediationAction {
  id              String   @id @default(cuid())
  // The finding being repaired
  findingId       String
  finding         ReconciliationFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  // The repair type (e.g., "M16_PUBLISHER_TRIGGER"). Only M16 is authorized.
  repairType      String
  // The status of the repair action: ATTEMPTED | SUCCEEDED | SKIPPED | FAILED
  status          String   @default("ATTEMPTED")
  // What the repair did (JSON snapshot — e.g., { publisherTriggerCalled: true, lagBefore: 360, lagAfter: 45 })
  actionSnapshot  String
  // When the repair was attempted
  attemptedAt     DateTime @default(now())
  // When the repair completed (set on SUCCEEDED/SKIPPED/FAILED)
  completedAt     DateTime?
  // Error message if the repair FAILED
  error           String?

  // Idempotency: one repair action per (findingId, repairType). A second attempt
  // to repair the same finding with the same repairType throws P2002 (unique
  // constraint) — the handler catches this and skips (SI-2: Repair Idempotency).
  @@unique([findingId, repairType])
  @@index([status, attemptedAt])
  @@index([repairType])
}

// ----------------------------------------
// P0-06 Wave-6 — Fulfilment (parallel state machine — additive-only)
// ----------------------------------------
// 1:1 to Order. Parallel to Order.status (NEXT_STATUS) — does NOT modify
// the existing Order state machine. Fulfilment has its own NEXT_FULFILMENT_STATUS
// machine: PREPARING → ALMOST_READY → READY_FOR_PICKUP → PICKED_UP.
//
// Lifecycle:
//   PREPARING        (default — created lazily on first access)
//     → ALMOST_READY
//     → READY_FOR_PICKUP
//     → PICKED_UP    (terminal)
//
// Lazy-created: when GET/PATCH /api/orders/[id]/fulfilment is called and no
// Fulfilment row exists yet, it is created with status='PREPARING' +
// pickupOtp copied from Order.pickupOtp.
//
// Optimistic locking: every PATCH uses a conditional UPDATE
// (`WHERE id = X AND version = expectedVersion`). A version mismatch returns
// HTTP 409 (same pattern as Order.status PATCH — P0-25 Case B).
//
// P0-07 (pickup attribution): pickupOtp / pickupVerifiedAt / pickupVerifiedBy
// fields are PRESENT but INACTIVE in this wave. No QR+OTP verification is
// performed on the PICKED_UP transition; no RBAC is enforced on the
// PICKED_UP actor. P0-07 activation is a separate Orchestrator directive.
model Fulfilment {
  id                String   @id @default(cuid())
  // 1:1 to Order — @unique ensures at most one Fulfilment per Order.
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id])
  // Parallel state machine (NEXT_FULFILMENT_STATUS) — does NOT touch Order.status.
  status            String   @default("PREPARING") // PREPARING | ALMOST_READY | READY_FOR_PICKUP | PICKED_UP
  // JSON array of {status, at} — parallel to Order.statusHistory.
  statusHistory     String   @default("[]")
  // P0-25: Optimistic-locking version field. Incremented on every PATCH.
  version           Int      @default(0)
  // P0-07 future: pickup attribution fields (INACTIVE in this wave).
  pickupOtp         String?  // copied from Order.pickupOtp on lazy-create
  pickupVerifiedAt  DateTime? // set when pickup is verified (P0-07 — not yet enforced)
  pickupVerifiedBy  String?  // actor who verified pickup (P0-07 — not yet enforced)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // --------------------------------------------------------------------
  // PRODUCT FOUNDATION (PLAN-01) — additive nullable timestamp (Decision #1).
  //
  // THIS IS NOT A STATE-MACHINE CHANGE.
  //
  // The Fulfilment.status enum remains exactly:
  //   PREPARING → ALMOST_READY → READY_FOR_PICKUP → PICKED_UP
  // (P0-06 boundary preserved — no new enum value, no transition added).
  //
  // `acceptedAt` is purely an informational timestamp set by the new
  // POST /api/vendor/orders/[id]/accept endpoint (Wave 3 Task 3C) to record
  // when the vendor acknowledged an incoming order — analogous to a "read
  // receipt". It does NOT drive any state transition, does NOT unlock any
  // downstream action, and does NOT modify the existing state invariant
  // checks in src/lib/fulfilment-state.ts (governance: DO NOT TOUCH).
  //
  // Rationale (plan Risk R1): blueprint §14 mentions an "ACCEPTED" state,
  // but adding it to the enum would trip P0-06 (state-machine immutability).
  // Modeling it as an additive timestamp achieves the UX goal (vendor
  // acknowledgement visible in the timeline) without the governance risk.
  // --------------------------------------------------------------------
  acceptedAt        DateTime?

  @@index([status])
}

// ============================================================================
// PRODUCT FOUNDATION — ADDITIVE MODELS (PLAN-01 / Wave 1 Task 1A)
// ============================================================================
// All models below are NEW and ADDITIVE. No existing model is modified
// except for the additive nullable columns + back-relations already appended
// to User, Restaurant, MenuItem, Fulfilment above.
//
// Governance: blueprint §29, §50. Do NOT touch existing money-state tables
// (Payment, Refund, LedgerEntry, Outbox, WebhookEvent, IdempotencyKey, AuditLog)
// or the fulfilment state machine (Fulfilment.status enum — see acceptedAt
// comment above: it is a timestamp, NOT a new enum value).
// ============================================================================

// ---------------------------------------------------------------------------
// Campus context (blueprint §40)
// ---------------------------------------------------------------------------
// A Campus represents an academic institution (college/university) that
// SnakZap serves. Users link to a campus during onboarding; restaurants link
// to one or more campuses via the RestaurantCampus junction (a chain can
// serve multiple campuses). The `domain` field is the email suffix used to
// verify student affiliation (e.g. "iitb.ac.in").
// ---------------------------------------------------------------------------
model Campus {
  id          String   @id @default(cuid())
  name        String   @unique
  shortName   String?  // e.g. "IIT-B"
  domain      String?  @unique // email suffix e.g. "iitb.ac.in"
  city        String
  state       String
  pincode     String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  // JSON: { defaultCurrency, commissionRate, mealPlanEnabled, studentDiscountPercent }
  settings    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  restaurants Restaurant[]
  restaurantCampuses RestaurantCampus[]

  @@index([city, state])
  @@index([isActive])
}

// Many-to-many junction: a restaurant can serve multiple campuses
// (e.g., a chain with 5 outlets near 3 campuses).
model RestaurantCampus {
  id           String   @id @default(cuid())
  restaurantId String
  campusId     String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  campus       Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, campusId])
  @@index([campusId])
}

// ---------------------------------------------------------------------------
// Rewards context (blueprint §17)
// ---------------------------------------------------------------------------
// Rewards engine: 1 pt per ₹10 spent (10 pts per ₹100); 100 pts = ₹10 discount
// (10% back). Ledger-based — RewardLedgerEntry is immutable + append-only.
// RewardAccount.balance is a CACHED sum (refreshed after every ledger mutation
// inside the same transaction — derived value, not authoritative).
//
// Idempotency: each issuance carries an idempotencyKey constructed as
// `${ruleKey}:${eventId}` by src/lib/rewards-engine.ts. The unique constraint
// on idempotencyKey prevents double-issuance on retry/duplicate event delivery.
// ---------------------------------------------------------------------------
model RewardAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  // Balance is DERIVED from RewardLedgerEntry sum, but cached here for fast reads.
  // Refreshed after every ledger mutation inside the same transaction.
  balance         Int      @default(0) // points (positive integer)
  lifetimeEarned  Int      @default(0) // points (sum of all EARN entries)
  lifetimeRedeemed Int     @default(0) // points (sum of all REDEEM entries, positive number)
  updatedAt       DateTime @updatedAt

  ledgerEntries   RewardLedgerEntry[]

  @@index([userId])
}

model RewardRule {
  id            String   @id @default(cuid())
  key           String   @unique // e.g. "EARN_BASE", "FIRST_ORDER", "STREAK_3"
  name          String
  description   String?
  // JSON formula spec — interpreted by src/lib/rewards-engine.ts:
  //   { "type": "perRupee", "rate": 0.1 } — 1 pt per ₹10
  //   { "type": "fixed", "points": 50 }
  //   { "type": "multiplier", "multiplier": 2 } — doubles base earn
  pointsFormula  String
  isActive      Boolean  @default(true)
  // Optional window for time-bound rules (e.g., campus event)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ledgerEntries RewardLedgerEntry[]
  redemptions   RewardRedemption[]

  @@index([isActive])
}

model RewardLedgerEntry {
  id             String   @id @default(cuid())
  userId         String
  // EARN (positive) | REDEEM (negative) | EXPIRE (negative) | ADJUST (±)
  type           String
  points         Int      // signed: + for EARN, - for REDEEM/EXPIRE
  // Optional context — set depending on rule type
  orderId        String?
  ruleId         String?
  rule           RewardRule? @relation(fields: [ruleId], references: [id])
  giftId         String?
  groupOrderId   String?
  referralUserId String? // for REFERRAL rule — the referee userId
  // Idempotency: one entry per idempotencyKey. Constructed as
  // `${ruleKey}:${eventId}` by src/lib/rewards-engine.ts.
  // Single-column @unique is stricter than @@unique([userId, idempotencyKey])
  // (globally unique, not per-user) — also satisfies the per-user requirement.
  idempotencyKey String   @unique
  // Optional expiry (EARN entries only) — when this timestamp passes,
  // a cron job creates a matching EXPIRE entry.
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  account        RewardAccount @relation(fields: [userId], references: [userId])
  // 1:1 back-relation — RewardRedemption.ledgerEntryId is @unique, so at most
  // one redemption per ledger entry (a REDEEM entry corresponds to exactly one
  // redemption code).
  redemption     RewardRedemption?

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])
  @@index([ruleId])
}

model RewardRedemption {
  id            String   @id @default(cuid())
  userId        String
  ledgerEntryId String   @unique // the REDEEM ledger entry (1:1)
  ledgerEntry   RewardLedgerEntry @relation(fields: [ledgerEntryId], references: [id])
  // PERCENT_DISCOUNT | FIXED_DISCOUNT | FREE_ITEM | VENDOR_SPECIFIC
  rewardType    String
  // For PERCENT_DISCOUNT: percent value (e.g., 5 = 5% off)
  // For FIXED_DISCOUNT: paise amount (e.g., 2000 = ₹20 off)
  // For FREE_ITEM: menuItemId
  // For VENDOR_SPECIFIC: dealId
  discountValue String
  // If redeemed against an order, the orderId; else null (generic redemption code)
  orderId       String?
  // Generated redemption code (e.g., "SNZ-RWD-AB12CD") — single-use
  redemptionCode String @unique
  redeemedAt    DateTime @default(now())

  ruleRuleId    String?
  rule          RewardRule? @relation(fields: [ruleRuleId], references: [id])

  @@index([userId, redeemedAt])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Gift context (blueprint §19)
// ---------------------------------------------------------------------------
// Food gifting lifecycle:
//   CREATED → PAID → AVAILABLE → REDEEMED | EXPIRED | CANCELLED | REFUNDED
//
// Implementation uses the "ghost Order" pattern (plan Decision #6):
//   - Sender pays for a normal Order via the EXISTING /api/payments route
//     (governance: DO NOT modify payment routes). Order.note encodes
//     `GIFT:${giftId}:for:${recipientId}` so the gift backend can correlate.
//   - The ghost Order is filtered from "My Orders" UI via note-prefix filter.
//   - Recipient's redemption creates a NEW zero-amount Order with note
//     `GIFT_FROM:${senderId}:${giftId}`. ZERO modifications to Order model.
//
// Payment linkage (paymentId) is a soft FK — no Prisma relation to Payment
// (governance: Payment is a money-state table, DO NOT TOUCH its relations).
// ---------------------------------------------------------------------------
model Gift {
  id             String   @id @default(cuid())
  senderId       String
  recipientId    String
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id])
  // Snapshot at creation time (price + name — protects against later menu edits)
  menuItemName   String
  menuItemPrice  Int      // paise
  message        String?
  // CREATED → PAID → AVAILABLE → REDEEMED | EXPIRED | CANCELLED | REFUNDED
  status         String   @default("CREATED")
  // Single-use code the recipient uses to redeem
  redemptionCode String   @unique
  // 30-day default expiry (set when status → AVAILABLE)
  expiresAt      DateTime
  // Soft FK to Payment.id — sender's payment (no Prisma relation; Payment is governance-protected)
  paymentId      String?
  // Recipient's order (set when recipient redeems) — soft FK to Order.id
  recipientOrderId String?
  // Lifecycle timestamps
  paidAt         DateTime?
  availableAt    DateTime?
  redeemedAt     DateTime?
  cancelledAt    DateTime?
  refundedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([senderId, createdAt])
  @@index([recipientId, status])
  @@index([status, expiresAt])
}

// ---------------------------------------------------------------------------
// Group ordering context (blueprint §20 — Model A: host pays)
// ---------------------------------------------------------------------------
// GroupOrder + GroupOrderMember + GroupOrderItem.
//
// Host creates → share code → friends join + add items to own cart →
// host confirm creates a single merged Order via direct prisma call inside
// withTransaction (NOT via /api/orders POST — avoids modifying that route).
//
// Concurrency: optimistic lock on GroupOrder.version (incremented on confirm;
// mismatch returns HTTP 409).
// ---------------------------------------------------------------------------
model GroupOrder {
  id            String   @id @default(cuid())
  hostId        String
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  // OPEN (members joining) | CONFIRMED (host confirmed + paid) | CLOSED (auto-closed) | CANCELLED
  status        String   @default("OPEN")
  // 6-character human-readable share code (e.g., "AB12CD")
  shareCode     String   @unique
  // Auto-close time (default createdAt + 24h)
  closesAt      DateTime
  // Host's confirmation
  confirmedAt   DateTime?
  // The single Order created on confirm — soft FK to Order.id (no relation to avoid touching Order)
  confirmedOrderId String?
  // Optimistic lock — incremented on confirm; conditional UPDATE prevents race
  version       Int      @default(0)
  // Group name (optional — e.g., "Tuesday lunch")
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       GroupOrderMember[]
  items         GroupOrderItem[]

  @@index([hostId, status])
  @@index([restaurantId, status])
  @@index([status, closesAt])
}

model GroupOrderMember {
  id            String   @id @default(cuid())
  groupOrderId  String
  groupOrder    GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  userId        String
  joinedAt      DateTime @default(now())

  items         GroupOrderItem[]

  @@unique([groupOrderId, userId])
  @@index([userId])
}

model GroupOrderItem {
  id            String   @id @default(cuid())
  groupOrderId  String
  groupOrder    GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  userId        String
  // Composite FK to GroupOrderMember — enforces that the user adding the item
  // is a member of the group (referential integrity at the DB layer).
  // References the @@unique([groupOrderId, userId]) on GroupOrderMember.
  member        GroupOrderMember @relation(fields: [groupOrderId, userId], references: [groupOrderId, userId])
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  name          String   // snapshot
  price         Int      // paise snapshot
  quantity      Int      @default(1)
  addedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([groupOrderId, userId])
  @@index([menuItemId])
}

// ---------------------------------------------------------------------------
// Social context (blueprint §18)
// ---------------------------------------------------------------------------
// Bidirectional follow = friend request + accept. 2 rows per mutual friendship
// (A→B + B→A) for clean queries.
//
// Activity feed verbs: ORDERED | ORDERED_ITEM (opt-in) | GIFTED | GROUP_ORDERED
// | REWARDED | REDEEMED — NEVER payment amount. metadata JSON is validated by
// Zod schema in src/lib/validation.ts (Wave 6) to forbid amount/total/price.
// ---------------------------------------------------------------------------
model SocialConnection {
  id            String   @id @default(cuid())
  followerId    String   // the user who initiated
  followeeId    String   // the user being followed
  // PENDING (request sent) | ACCEPTED | REJECTED | BLOCKED
  status        String   @default("PENDING")
  requestedAt   DateTime @default(now())
  acceptedAt    DateTime?
  // Optional message with friend request
  message       String?
  // S4A: who initiated the block. NULL for non-block rows.
  // Legacy BLOCKED rows with NULL = fail-closed (no one can unblock without explicit repair).
  blockedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([followerId, followeeId])
  @@index([followeeId, status])
  @@index([followerId, status])
}

model SocialActivity {
  id            String   @id @default(cuid())
  actorId       String   // the user who performed the action
  // ORDERED | ORDERED_ITEM | GIFTED | GROUP_ORDERED | REWARDED | REDEEMED
  verb          String
  // Restaurant | MenuItem | Gift | GroupOrder | RewardLedgerEntry | RewardRedemption
  objectType   String
  objectId      String
  // JSON metadata — NEVER includes payment amount
  // e.g., { restaurantName, itemName?, recipientName? }
  metadata      String   @default("{}")
  // FRIENDS (default) | PUBLIC | PRIVATE
  visibility    String   @default("FRIENDS")
  createdAt     DateTime @default(now())

  // S5H1: Authoritative link to the Order that triggered this activity.
  // NULL for activities not tied to a specific order (e.g., FRIEND_ADDED,
  // legacy client-created ORDERED activities).
  // Server-set ONLY via POST /api/social/share-order — client cannot set this.
  // Used by GET /api/restaurants/[id]/social-proof to verify economic truth
  // (real Order with qualifying status) + explicit share consent (visibility).
  sourceOrderId String?
  sourceOrder   Order?   @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([verb, createdAt])
  // S5H1: Idempotency — one ORDERED share per (actorId, sourceOrderId).
  // Prevents duplicate social-proof amplification from repeated share calls.
  // Only applies when sourceOrderId IS NOT NULL (legacy rows have NULL → excluded).
  @@unique([actorId, sourceOrderId])
}

// ---------------------------------------------------------------------------
// GJ-02 S2: Persistent Likes
// ---------------------------------------------------------------------------
// A Like is a user's endorsement of a SocialActivity. Exactly one Like per
// user per activity (enforced by @@unique([userId, activityId])). The likeCount
// for an activity is derived via COUNT(*) on this table.
// ---------------------------------------------------------------------------
model Like {
  id          String   @id @default(cuid())
  userId      String   // the user who liked (always from session, never client-supplied)
  activityId  String   // the SocialActivity being liked
  createdAt   DateTime @default(now())

  @@unique([userId, activityId])
  @@index([activityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Notification context
// ---------------------------------------------------------------------------
// Simple notification store. Read by GET /api/notifications (Wave 2+).
// readAt=null means unread; setting readAt marks as read.
// ---------------------------------------------------------------------------
model Notification {
  id            String   @id @default(cuid())
  userId        String   // recipient
  // UPPERCASE: FRIEND_REQUEST_RECEIVED | FRIEND_REQUEST_ACCEPTED | SOCIAL_ACTIVITY_LIKED |
  // GIFT_RECEIVED | GIFT_REDEEMED | ORDER_ACCEPTED | REWARD_EARNED |
  // GROUP_ORDER_CONFIRMED | GROUP_ORDER_CANCELLED | SYSTEM
  type          String
  title         String
  body          String
  // JSON: deep link + action buttons + context
  data          String   @default("{}")
  // GJ-02 S3: deterministic dedup key for exactly-once notification per source event
  dedupKey      String?
  readAt        DateTime?
  createdAt     DateTime @default(now())

  @@unique([userId, dedupKey])  // exactly-one notification per user per source event
  @@index([userId, readAt])
  @@index([type, createdAt])
}
